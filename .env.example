# =============================================================================
#  CampusCycle / Student Marketplace — environment variables
#  Copy this file to `.env.local` and fill in your own values:
#      cp .env.example .env.local        (macOS / Linux)
#      copy .env.example .env.local      (Windows)
#
#  `.env.local` is gitignored and must NEVER be committed.
# =============================================================================

# --- Database (SERVER ONLY — never expose these to the browser) --------------
# MongoDB Atlas connection string. This is a SECRET. It must never be prefixed
# with NEXT_PUBLIC_, and it is only ever read from server code (lib/db/connect.ts).
# The actual password must come from `.env.local` (never hardcode or commit it).
#
# MongoDB Atlas (student_marketplace database):
MONGODB_URI=
# Example:
# MONGODB_URI=mongodb+srv://student_marketplace:YOUR_PASSWORD@chat.dowc62o.mongodb.net/student_marketplace?retryWrites=true&w=majority
#
# Local MongoDB (development):
# MONGODB_URI=mongodb://127.0.0.1:27017/student_marketplace

# Optional. Overrides the database name embedded in the connection string.
# MONGODB_DB_NAME=student_marketplace

# --- Authentication (SERVER ONLY) -------------------------------------------
# Secret used to sign and verify the session JWT. Generate a long random value
# (e.g. `openssl rand -base64 48`) and keep it out of version control.
# Must be at least 16 characters. Never prefix with NEXT_PUBLIC_.
JWT_SECRET=

# --- Public configuration (safe to expose to the browser) --------------------
# Only variables prefixed with NEXT_PUBLIC_ are inlined into client bundles.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAX_IMAGES=5
